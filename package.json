{
  "name": "haunted-house-layout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Phone-first shared map and kid-height walkthrough for the school haunted house gym layout",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "nipplejs": "1.0.4",
    "partyserver": "0.5.10",
    "perfect-freehand": "1.2.3",
    "three": "0.186.0",
    "y-indexeddb": "9.0.12",
    "y-partyserver": "2.2.0",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.8",
    "@playwright/test": "1.63.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.130.0"
  }
}
